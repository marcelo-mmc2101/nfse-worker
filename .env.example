PORT=3000

# Senha de acesso a ESTE worker (header X-API-Key). Não tem relação com o
# certificado nem com a Receita: serve para que só o seu app consiga mandar
# emitir.
#
# ATENÇÃO: nenhuma hospedagem cria esta variável por você. O worker é
# fail-closed — sem ela no ar, ele sobe, passa no teste de saúde (/health é
# público) e RECUSA TODA chamada real. Parece vivo e não serve para nada.
#
# O app gera a chave para você: em Configurações e depois NFS-e, clique em
# Gerar no campo "Chave do servidor" e cole o mesmo valor aqui.
NFSE_WORKER_API_KEY=cole-aqui-a-chave-gerada-no-app
